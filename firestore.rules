rules_version = '2';

// Règles de sécurité Firestore — HT Maintenance.
// Seuls les techniciens authentifiés (comptes créés dans Firebase Console → Authentication)
// peuvent lire et écrire les données. Personne d'autre (visiteur non connecté) n'y a accès.
//
// À copier dans : Firebase Console → Firestore Database → Onglet "Règles" → coller → Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
